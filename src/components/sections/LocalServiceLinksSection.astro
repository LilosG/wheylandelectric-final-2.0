---
import Section from '../ui/Section.astro';
import type { PriorityCityServiceLink } from '../../data/priorityInternalLinks';

interface LinkGroup {
  title: string;
  links: PriorityCityServiceLink[];
}

interface Props {
  title?: string;
  subtitle?: string;
  links?: PriorityCityServiceLink[];
  groups?: LinkGroup[];
  bg?: 'white' | 'subtle';
}

const {
  title = 'Popular Local Electrical Services',
  subtitle,
  links = [],
  groups = [],
  bg = 'white',
} = Astro.props;
---

<Section bg={bg}>
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-heading text-2xl font-bold text-brand-slate md:text-3xl">{title}</h2>
      <span class="mx-auto mt-3 block h-0.5 w-16 bg-brand-teal"></span>
      {subtitle && <p class="mx-auto mt-4 max-w-2xl text-text-muted">{subtitle}</p>}
    </div>

    {groups.length > 0 ? (
      <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
        {groups.map((group) => (
          <div class="rounded-xl border border-surface-subtle bg-white p-5 shadow-sm">
            <h3 class="font-heading text-base font-bold text-brand-slate">{group.title}</h3>
            <ul class="mt-4 space-y-2">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="inline-flex text-sm font-semibold text-brand-teal transition-colors hover:text-brand-slate">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        {links.map((link) => (
          <a
            href={link.href}
            class="rounded-full border border-brand-teal/30 bg-white px-4 py-2 text-sm font-semibold text-brand-slate shadow-sm transition-colors hover:border-brand-teal hover:text-brand-teal"
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
</Section>
