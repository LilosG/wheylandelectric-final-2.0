---
const message = 'Planning an EV charger, panel upgrade, remodel, spa, or added circuit? Use our electrical load calculator to estimate whether your current service may need licensed review.';
---
<section class="bg-brand-teal/10 py-10">
  <div class="mx-auto max-w-5xl rounded-2xl border border-brand-teal/20 bg-white px-6 py-8 text-center shadow-sm">
    <p class="text-lg font-semibold text-brand-slate md:text-xl">{message}</p>
    <div class="mt-5 flex flex-wrap justify-center gap-3">
      <a href="/tools/load-calculator/" class="rounded-lg bg-brand-teal px-5 py-3 font-semibold text-white hover:bg-brand-slate">Open Load Calculator</a>
      <a href="/free-estimates/" class="rounded-lg border border-brand-slate/20 px-5 py-3 font-semibold text-brand-slate hover:bg-slate-50">Request Free Estimate</a>
    </div>
  </div>
</section>
