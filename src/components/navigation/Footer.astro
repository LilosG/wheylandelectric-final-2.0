---
import { site } from '../../data/site';
import { getNeighborhoodPillars } from '../../data/services';
import { getGoogleRating } from '../../lib/googlePlaces';

const services = getNeighborhoodPillars();
const liveRating = await getGoogleRating();
const linkClass = 'text-white/70 hover:text-white text-sm transition-colors block py-1';
const socialLinks = [
  { label: 'Facebook', href: site.social.facebook },
  { label: 'Instagram', href: site.social.instagram },
  { label: 'LinkedIn', href: site.social.linkedin },
  { label: 'YouTube', href: site.social.youtube },
];
---

<footer class="bg-brand-navy text-white">
  {/* Top badge row */}
  <div class="border-b border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-6 sm:px-6 lg:px-8"
    >
      <div class="flex items-center">
        <img
          src="/images/logo/wheyland-electric-logo-footer.webp"
          alt="Wheyland Electric"
          width="300"
          height="85"
          class="h-16 w-auto"
          loading="lazy"
        />
      </div>
      <div class="flex items-center gap-1">
        {
          [1, 2, 3, 4, 5].map(() => (
            <svg class="h-4 w-4 text-brand-gold" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          ))
        }
        <span class="ml-2 text-sm text-white/60">{liveRating.count} reviews</span>
      </div>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-white/70">
        <span>{site.nap.address.full}</span>
        <a
          href={`tel:${site.nap.phoneTel}`}
          class="font-semibold text-white transition-colors hover:text-brand-teal"
          >{site.nap.phone}</a
        >
      </div>
    </div>
  </div>

  {/* Main 4-column grid */}
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-10">
      {/* Col 1: About */}
      <div>
        <h3 class="mb-4 font-heading text-base font-bold text-white">Wheyland Electric</h3>
        <p class="mb-4 text-sm leading-relaxed text-white/60">{site.tagline}</p>
        <address class="space-y-1 text-sm not-italic text-white/60">
          <p>{site.nap.address.street}</p>
          <p>{site.nap.address.city}, {site.nap.address.state} {site.nap.address.zip}</p>
        </address>
        <p class="mt-3 text-xs text-white/50">{site.license}</p>
      </div>

      {/* Col 2: Quick Links */}
      <div>
        <h3 class="mb-4 font-heading text-base font-bold text-white">Quick Links</h3>
        <nav class="space-y-0.5">
          <a href="/services/" class={linkClass}>Services</a>
          <a href="/service-areas/" class={linkClass}>Service Areas</a>
          <a href="/about/" class={linkClass}>About Us</a>
          <a href="/about/licenses/" class={linkClass}>Licenses & Trust</a>
          <a href="/contact-us/" class={linkClass}>Contact</a>
          <a href="/free-estimates/" class={linkClass}>Free Estimates</a>
          <a href="/blog/" class={linkClass}>Blog</a>
        </nav>
      </div>

      {/* Col 3: Services */}
      <div>
        <h3 class="mb-4 font-heading text-base font-bold text-white">Services</h3>
        <nav class="space-y-0.5">
          {
            services.map((service) => (
              <a href={`/services/${service.slug}/`} class={linkClass}>
                {service.name}
              </a>
            ))
          }
          <a
            href="/services/"
            class="mt-1 block py-1 text-sm text-brand-teal/70 transition-colors hover:text-brand-teal"
            >View all services &rarr;</a
          >
        </nav>
      </div>

      {/* Col 4: Contact */}
      <div>
        <h3 class="mb-4 font-heading text-base font-bold text-white">Contact</h3>
        <div class="space-y-3 text-sm">
          <div class="flex items-center gap-2">
            <svg
              class="h-4 w-4 shrink-0 text-brand-teal"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path>
            </svg>
            <a
              href={`tel:${site.nap.phoneTel}`}
              class="font-medium text-white transition-colors hover:text-brand-teal"
              >{site.nap.phone}</a
            >
          </div>
          <div class="flex items-center gap-2">
            <svg
              class="h-4 w-4 shrink-0 text-brand-teal"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a
              href={`mailto:${site.nap.email}`}
              class="text-white/70 transition-colors hover:text-white">{site.nap.email}</a
            >
          </div>
          <div class="flex items-start gap-2">
            <svg
              class="mt-0.5 h-4 w-4 shrink-0 text-brand-teal"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div class="text-white/70">
              <p>{site.hours.weekday}</p>
              <p>{site.hours.weekend}</p>
            </div>
          </div>
        </div>

        <nav
          class="mt-6 flex flex-wrap gap-x-4 gap-y-2"
          aria-label="Wheyland Electric social profiles"
        >
          {
            socialLinks.map((social) => (
              <a
                href={social.href}
                class="text-xs font-medium text-white/55 transition-colors hover:text-brand-teal"
                target="_blank"
                rel="noopener noreferrer"
              >
                {social.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>

  {/* Bottom bar */}
  <div class="border-t border-white/10">
    <div
      class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-6 text-xs text-white/50 sm:flex-row sm:px-6 lg:px-8"
    >
      <p>&copy; {new Date().getFullYear()} {site.nap.name}. All rights reserved.</p>
      <p>Licensed, Bonded & Insured &middot; {site.license}</p>
      <p>
        Website built by{' '}
        <a
          href={site.credit.url}
          class="text-white/60 underline decoration-white/20 underline-offset-2 transition-colors hover:text-brand-teal hover:decoration-brand-teal"
          target="_blank"
          rel="noopener noreferrer"
        >
          {site.credit.label}
        </a>
      </p>
    </div>
  </div>
</footer>
