---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import { privacyPolicyMeta } from '../lib/seo';
import { breadcrumbSchemaNode } from '../lib/schema/breadcrumb';
import { graphSchema, webPageSchemaNode } from '../lib/schema/graph';
import { site } from '../data/site';

const meta = privacyPolicyMeta();
---

<PageLayout
  meta={meta}
  schemas={[
    graphSchema([
      webPageSchemaNode({
        type: 'WebPage',
        path: '/privacy-policy/',
        name: meta.title,
        description: meta.description,
      }),
      breadcrumbSchemaNode(
        [{ label: 'Privacy Policy', href: '/privacy-policy/' }],
        '/privacy-policy/'
      ),
    ]),
  ]}
  breadcrumbs={[{ label: 'Privacy Policy', href: '/privacy-policy/' }]}
>
  <Section bg="subtle">
    <div class="mx-auto max-w-3xl py-8 md:py-12">

      <header class="mb-10 border-b border-surface-subtle pb-8">
        <h1 class="font-heading text-3xl font-bold text-brand-slate md:text-4xl">Privacy Policy</h1>
        <p class="mt-3 text-sm text-text-muted">Effective Date: August 11, 2026</p>
      </header>

      <div class="prose prose-slate max-w-none prose-headings:font-heading prose-headings:font-bold prose-headings:text-brand-slate prose-a:text-brand-teal prose-a:no-underline hover:prose-a:underline prose-strong:text-brand-slate">

        <p>
          {site.nap.name}, Inc. (&ldquo;Wheyland Electric,&rdquo; &ldquo;we,&rdquo; &ldquo;us,&rdquo; or &ldquo;our&rdquo;) respects your privacy and is committed to protecting the personal information you provide to us.
        </p>
        <p>
          This Privacy Policy explains how we collect, use, and protect information when you contact us, request our services, communicate with us by phone or text message, visit our website, or otherwise interact with Wheyland Electric.
        </p>

        <h2>Information We Collect</h2>
        <p>We may collect information that you voluntarily provide to us, including:</p>
        <ul>
          <li>Your name</li>
          <li>Phone number</li>
          <li>Email address</li>
          <li>Property or service address</li>
          <li>Information about your electrical project or service needs</li>
          <li>Appointment and scheduling information</li>
          <li>Information you provide through our website, request forms, or other communications</li>
          <li>Photos, documents, or other information you provide in connection with a service request</li>
          <li>Payment and billing information when necessary to process transactions</li>
        </ul>
        <p>We may also collect basic information about how you interact with our website or electronic communications.</p>

        <h2>How We Use Your Information</h2>
        <p>We may use the information we collect to:</p>
        <ul>
          <li>Respond to inquiries and requests for estimates</li>
          <li>Schedule and manage appointments</li>
          <li>Provide electrical services</li>
          <li>Communicate with you regarding your project or account</li>
          <li>Send appointment reminders and service updates</li>
          <li>Send quotes, invoices, receipts, and payment-related information</li>
          <li>Provide customer support</li>
          <li>Respond to questions or requests</li>
          <li>Maintain business and service records</li>
          <li>Improve our services and customer experience</li>
          <li>Comply with applicable legal and regulatory requirements</li>
        </ul>

        <h2>Text Messages and SMS Communications</h2>
        <p>
          If you provide your phone number and consent to receive text messages from Wheyland Electric, we may use text messaging to communicate with you regarding your services and account.
        </p>
        <p>Text messages may include appointment confirmations and reminders, scheduling information, service updates, estimate and quote communications, invoice or payment notifications, customer support messages, and other communications related to services you have requested.</p>
        <p>Message frequency varies depending on your interactions and service needs. Message and data rates may apply.</p>
        <p>
          You can opt out of receiving text messages at any time by replying <strong>STOP</strong> to a text message from us. After you send STOP, you will receive confirmation that you have been unsubscribed and you will no longer receive text messages from us, except where permitted or required by law.
        </p>
        <p>
          For assistance with text messaging, reply <strong>HELP</strong> or contact us using the information below.
        </p>
        <p>Consent to receive text messages is not a condition of purchasing goods or services from Wheyland Electric.</p>

        <h2>How We Share Information</h2>
        <p>We do not sell or rent your personal information.</p>
        <p>
          We may share information with trusted service providers who assist us in operating our business, such as scheduling, customer management, payment processing, communications, website hosting, and other business services. These providers may only use information as necessary to provide services to us.
        </p>
        <p>
          We may also disclose information when required by law, legal process, or governmental authority, or when reasonably necessary to protect our rights, customers, employees, or business.
        </p>

        <h2>Data Security</h2>
        <p>
          We take reasonable measures to protect personal information from unauthorized access, use, disclosure, alteration, or destruction. However, no method of electronic storage or transmission is completely secure, and we cannot guarantee absolute security.
        </p>

        <h2>Information Retention</h2>
        <p>
          We may retain customer information for as long as reasonably necessary to provide services, maintain business and financial records, resolve disputes, comply with legal obligations, and for legitimate business purposes.
        </p>

        <h2>Your Choices and Rights</h2>
        <p>
          You may contact us to request access to, correction of, or updates to certain personal information we maintain about you.
        </p>
        <p>
          You may also opt out of text messages by replying <strong>STOP</strong>, or request assistance by replying <strong>HELP</strong>.
        </p>

        <h2>Third-Party Services and Links</h2>
        <p>
          Our website or communications may contain links to third-party websites or services. We are not responsible for the privacy practices or content of third-party websites. We encourage you to review their privacy policies before providing personal information.
        </p>

        <h2>Children&rsquo;s Privacy</h2>
        <p>
          Our services are intended for adults and businesses and are not directed toward children under the age of 13. We do not knowingly collect personal information from children under 13.
        </p>

        <h2>Changes to This Privacy Policy</h2>
        <p>
          We may update this Privacy Policy from time to time to reflect changes in our business practices, services, technology, or legal requirements. Any updated policy will be posted on this page with a revised effective date.
        </p>

        <h2>Contact Us</h2>
        <p>If you have questions about this Privacy Policy or how we handle your information, please contact:</p>
        <address class="not-italic">
          <strong>{site.nap.name}, Inc.</strong><br />
          Phone: <a href={`tel:${site.nap.phoneTel}`}>{site.nap.phone}</a><br />
          Email: <a href={`mailto:${site.nap.email}`}>{site.nap.email}</a><br />
          Address: {site.nap.address.full}<br />
          Website: <a href="https://www.wheylandelectric.com" target="_blank" rel="noopener noreferrer">www.wheylandelectric.com</a>
        </address>

      </div>
    </div>
  </Section>
</PageLayout>
