---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import { termsAndConditionsMeta } from '../lib/seo';
import { breadcrumbSchemaNode } from '../lib/schema/breadcrumb';
import { graphSchema, webPageSchemaNode } from '../lib/schema/graph';
import { site } from '../data/site';

const meta = termsAndConditionsMeta();
---

<PageLayout
  meta={meta}
  schemas={[
    graphSchema([
      webPageSchemaNode({
        type: 'WebPage',
        path: '/terms-and-conditions/',
        name: meta.title,
        description: meta.description,
      }),
      breadcrumbSchemaNode(
        [{ label: 'Terms & Conditions', href: '/terms-and-conditions/' }],
        '/terms-and-conditions/'
      ),
    ]),
  ]}
  breadcrumbs={[{ label: 'Terms & Conditions', href: '/terms-and-conditions/' }]}
>
  <Section bg="subtle">
    <div class="mx-auto max-w-3xl py-8 md:py-12">

      <header class="mb-10 border-b border-surface-subtle pb-8">
        <h1 class="font-heading text-3xl font-bold text-brand-slate md:text-4xl">Terms &amp; Conditions</h1>
        <p class="mt-3 text-sm text-text-muted">Effective Date: August 11, 2026</p>
      </header>

      <div class="prose prose-slate max-w-none prose-headings:font-heading prose-headings:font-bold prose-headings:text-brand-slate prose-a:text-brand-teal prose-a:no-underline hover:prose-a:underline prose-strong:text-brand-slate">

        <p>
          Welcome to {site.nap.name}, Inc. (&ldquo;Wheyland Electric,&rdquo; &ldquo;we,&rdquo; &ldquo;us,&rdquo; or &ldquo;our&rdquo;). These Terms &amp; Conditions govern your use of our website and your interactions with Wheyland Electric, including requests for estimates, scheduling, electrical services, and communications by phone or text message.
        </p>
        <p>By requesting or using our services, you agree to these Terms &amp; Conditions.</p>

        <h2>Services</h2>
        <p>
          Wheyland Electric provides electrical contracting and related services. The specific services provided, scope of work, pricing, materials, scheduling, and other project details will be communicated through estimates, proposals, work orders, agreements, or other documentation provided to the customer.
        </p>
        <p>An estimate or proposal does not necessarily constitute acceptance of a contract. Work will be performed according to the terms agreed upon between Wheyland Electric and the customer.</p>

        <h2>Estimates and Pricing</h2>
        <p>
          Estimates are based on the information reasonably available to us at the time the estimate is prepared. Actual project costs may change if site conditions, customer requests, material costs, code requirements, or the scope of work differs from the information available when the estimate was prepared.
        </p>
        <p>Any additional work or changes to the agreed scope may result in additional charges.</p>

        <h2>Scheduling</h2>
        <p>
          Appointments are scheduled based on availability. We will make reasonable efforts to arrive within the scheduled appointment window, but circumstances such as emergencies, prior job conditions, weather, traffic, material availability, or other unforeseen circumstances may affect scheduling.
        </p>
        <p>We may contact customers by phone, email, or text message regarding appointments and scheduling.</p>

        <h2>Customer Responsibilities</h2>
        <p>
          Customers are responsible for providing accurate information necessary for us to evaluate and perform requested services. Customers should provide reasonable access to the property and areas where electrical work is to be performed.
        </p>
        <p>
          Customers are responsible for notifying us of known conditions that may affect the work, including access restrictions, hazards, or other relevant property conditions.
        </p>

        <h2>Text Messaging Terms</h2>
        <p>
          By providing your phone number and consenting to receive text messages from Wheyland Electric, you agree that we may send text messages related to your requested services and customer relationship.
        </p>
        <p>These messages may include:</p>
        <ul>
          <li>Appointment confirmations and reminders</li>
          <li>Scheduling communications</li>
          <li>Estimate and quote updates</li>
          <li>Service updates</li>
          <li>Customer support communications</li>
          <li>Invoice and payment notifications</li>
          <li>Other messages related to services you have requested</li>
        </ul>
        <p>Message frequency varies based on your interactions with Wheyland Electric. Message and data rates may apply.</p>
        <p>
          You may opt out of text messages at any time by replying <strong>STOP</strong>. After opting out, you will receive a confirmation message and will no longer receive text messages from us, except where permitted or required by law.
        </p>
        <p>
          For assistance, reply <strong>HELP</strong> or contact Wheyland Electric at <a href={`tel:${site.nap.phoneTel}`}>{site.nap.phone}</a>.
        </p>
        <p>Consent to receive text messages is not a condition of purchasing any goods or services.</p>

        <h2>Payments</h2>
        <p>
          Payment terms will be provided in the applicable estimate, proposal, invoice, or service agreement. Customers agree to pay amounts due according to the agreed payment terms.
        </p>

        <h2>Cancellations and Rescheduling</h2>
        <p>
          Customers should contact Wheyland Electric as soon as possible if they need to cancel or reschedule an appointment. Any applicable cancellation or rescheduling policies will be communicated to the customer as appropriate.
        </p>

        <h2>Website Use</h2>
        <p>
          Information provided on our website is intended for general informational purposes. While we make reasonable efforts to keep information accurate and current, we do not guarantee that all website content is complete, current, or error-free.
        </p>

        <h2>Third-Party Services</h2>
        <p>
          Wheyland Electric may use third-party providers to assist with scheduling, customer communications, payment processing, website services, and other business operations. Your use of services involving a third party may also be subject to that provider&rsquo;s terms and policies.
        </p>

        <h2>Limitation of Liability</h2>
        <p>
          To the extent permitted by applicable law, Wheyland Electric shall not be responsible for indirect, incidental, consequential, or special damages arising from the use of our website or communications, except where such limitation is prohibited by law.
        </p>
        <p>Nothing in these Terms &amp; Conditions is intended to waive or limit any rights or obligations that cannot legally be waived or limited.</p>

        <h2>Changes to These Terms</h2>
        <p>
          We may update these Terms &amp; Conditions from time to time. Updated terms will be posted on this page with a revised effective date. Your continued use of our website or services after an update constitutes acceptance of the revised terms to the extent permitted by law.
        </p>

        <h2>Contact Us</h2>
        <p>If you have questions about these Terms &amp; Conditions, please contact:</p>
        <address class="not-italic">
          <strong>{site.nap.name}, Inc.</strong><br />
          Phone: <a href={`tel:${site.nap.phoneTel}`}>{site.nap.phone}</a><br />
          Email: <a href={`mailto:${site.nap.email}`}>{site.nap.email}</a><br />
          Address: {site.nap.address.full}<br />
          Website: <a href="https://www.wheylandelectric.com" target="_blank" rel="noopener noreferrer">www.wheylandelectric.com</a>
        </address>

      </div>
    </div>
  </Section>
</PageLayout>
